{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunMetadata",
  "type": "object",
  "required": [
    "run_id",
    "created_at",
    "request",
    "status"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "request": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "lens": {
      "type": "string"
    },
    "mock": {
      "type": "boolean"
    }
  }
}