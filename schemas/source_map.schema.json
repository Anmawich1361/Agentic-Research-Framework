{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceMap",
  "type": "object",
  "required": [
    "sources",
    "scores",
    "gaps"
  ],
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "$ref": "source.schema.json"
      }
    },
    "scores": {
      "type": "array",
      "items": {
        "$ref": "source_score.schema.json"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  }
}