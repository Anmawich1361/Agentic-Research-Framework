{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceClaim",
  "type": "object",
  "required": [
    "id",
    "claim",
    "claim_type",
    "confidence",
    "report_section"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "claim": {
      "type": "string"
    },
    "claim_type": {
      "type": "string",
      "enum": [
        "fact",
        "inference",
        "opinion",
        "unknown"
      ]
    },
    "source_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_title": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "report_section": {
      "type": "string"
    },
    "quote_or_excerpt": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}