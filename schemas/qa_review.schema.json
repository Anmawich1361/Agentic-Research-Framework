{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QAReview",
  "type": "object",
  "required": [
    "ready_to_publish",
    "issues"
  ],
  "properties": {
    "ready_to_publish": {
      "type": "boolean"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "problem": {
            "type": "string"
          },
          "suggested_fix": {
            "type": "string"
          },
          "affected_section": {
            "type": [
              "string",
              "null"
            ]
          },
          "category": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "unsupported_claim",
              "weak_source",
              "missing_recent_signal",
              "overconfident_inference",
              "source_gap",
              "stale_or_unclear_recency",
              "missing_user_context",
              "report_structure_issue",
              null
            ]
          }
        }
      }
    },
    "summary": {
      "type": "string"
    }
  }
}
